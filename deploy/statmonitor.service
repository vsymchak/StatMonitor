[Unit]
Description=StatMonitor Autonomous Betting Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/StatMonitor
ExecStart=/home/ubuntu/StatMonitor/venv/bin/python -u daemon.py --interval 30
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
EnvironmentFile=/home/ubuntu/StatMonitor/.env

[Install]
WantedBy=multi-user.target
